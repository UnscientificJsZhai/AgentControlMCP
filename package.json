{
  "name": "agent-control-mcp",
  "version": "1.0.0",
  "description": "通过 MCP 管理 ACP Agent 的连接器",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "scripts": {
    "build": "node scripts/clean.mjs build && tsc -p tsconfig.build.json && node scripts/write-service-build.mjs",
    "build:watch": "node scripts/clean.mjs build && tsc -p tsconfig.build.json --watch",
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format:check": "prettier . --check",
    "format": "prettier . --write",
    "test": "npm run test:compile && node --test --test-timeout=5000 \".test-dist/test/unit/**/*.test.js\" && npm run test:process:compiled",
    "test:unit": "npm run test:compile:unit && node --test --test-timeout=5000 \".test-dist/test/unit/**/*.test.js\"",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run build && npm test",
    "check:ci": "npm run format:check && npm run lint && npm run typecheck && npm run build && npm run test:unit",
    "test:compile": "node scripts/clean.mjs test && tsc -p tsconfig.test.json",
    "test:compile:unit": "node scripts/clean.mjs test && tsc -p tsconfig.test-unit.json",
    "build:windows-host": "node scripts/build-windows-host.mjs",
    "prepack": "npm run build && node scripts/check-package.mjs",
    "test:process": "npm run test:compile && npm run build && node --test --test-timeout=20000 \".test-dist/test/process/**/*.test.js\"",
    "test:process:compiled": "npm run build && node --test --test-timeout=20000 \".test-dist/test/process/**/*.test.js\""
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "tar": "7.5.22",
    "unbzip2-stream": "1.4.3",
    "yauzl": "3.4.0",
    "zod": "4.2.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "24.13.6",
    "@types/unbzip2-stream": "1.4.3",
    "@types/yauzl": "3.4.0",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "prettier": "3.9.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  },
  "bin": {
    "agent-control-mcp": "dist/cli/entry.js"
  },
  "files": [
    "dist",
    "native/win32-*/*.exe",
    "docs/acceptance.md",
    "docs/mcp-tools.md",
    "docs/storage.md",
    "docs/collaboration.md",
    "docs/service-lifecycle.md",
    "plan/feature-unified-execution-service-1*.md"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "license": "UNLICENSED"
}
