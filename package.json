{
  "name": "agent-control-mcp",
  "version": "1.0.0",
  "description": "通过 MCP 管理 ACP Agent 的连接器",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "scripts": {
    "build": "node scripts/clean.mjs build && tsc -p tsconfig.build.json",
    "build:watch": "node scripts/clean.mjs build && tsc -p tsconfig.build.json --watch",
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format:check": "prettier . --check",
    "format": "prettier . --write",
    "test": "npm run test:unit",
    "test:unit": "node scripts/clean.mjs test && tsc -p tsconfig.test.json && node --test \".test-dist/test/unit/**/*.test.js\"",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run build && npm test"
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.6",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "prettier": "3.9.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  }
}
